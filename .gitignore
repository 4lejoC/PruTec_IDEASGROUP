# Único .gitignore del repositorio (backend, frontend, base de datos).
# Los patrones sin "/" inicial aplican en cualquier carpeta.

# ===== Secretos / entorno =====
.env
.env.*
!.env.example
appsettings.*.local.json

# ===== Archivos personales de la prueba (no publicar) =====
*.pdf
CHECKLIST.md

# ===== .NET / Visual Studio =====
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
TestResults/
*.log

# ===== Angular / Node =====
node_modules/
dist/
out-tsc/
.angular/
coverage/
.sass-cache/
npm-debug.log*
yarn-error.log
testem.log

# ===== Editores =====
# VS Code: se versionan extensions/launch/tasks del frontend; settings.json es personal.
**/.vscode/settings.json
.vscode/*
!.vscode/extensions.json
.history/
.idea/
.project
.classpath
.settings/
*.sublime-workspace

# ===== Sistema operativo =====
Thumbs.db
.DS_Store

# ===== PowerDesigner (temporales, respaldos y workspace local) =====
*.bak
*.tmp
*.cdb
*.ldb
*.pdb
*.sws
