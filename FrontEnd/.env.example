# Copiar este archivo como .env (en la carpeta FrontEnd) y completar los valores.
# El archivo .env NO se versiona.
# Las variables deben empezar con NG_APP_ para que @ngx-env/builder las exponga a Angular.
# Nota: estos valores quedan incluidos en el JavaScript que recibe el navegador,
# por lo que nunca deben contener secretos (solo URLs y configuración pública).

# URL base de la API del backend
NG_APP_API_URL=http://localhost:5257/api
