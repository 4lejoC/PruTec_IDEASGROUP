# Copiar este archivo como .env (en la raíz del repositorio) y completar los valores.
# El archivo .env NO se versiona.

# ===== Base de datos (usadas por docker-compose) =====
POSTGRES_DB=gestion_tareas
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# ===== Backend (.NET) =====
# El doble guion bajo (__) equivale a una sección de configuración: ConnectionStrings:DefaultConnection
# Los valores ${...} se reemplazan con las variables definidas arriba.
ConnectionStrings__DefaultConnection="Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

# Orígenes permitidos por CORS (URL del frontend). Varios valores separados por coma.
Cors__AllowedOrigins=http://localhost:4200
